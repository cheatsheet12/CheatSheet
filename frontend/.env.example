# ==========================================================================
# frontend/.env.example — environment variable template for the Next.js panel
#
# Copy to `frontend/.env.local` and fill it in. `.env*` files are excluded
# from the repository: they are NEVER committed.
#
# The backend has its own template in backend/.env.example — an env file lives
# next to the process that reads it, and these are two separately deployed
# processes. In staging both run on Render: this panel on the Node runtime, the
# API as a Docker service (ADR-0006). Neither of them reads the other's file.
# ==========================================================================

# --------------------------------------------------------------------------
# Backend API — read by the BFF route handlers, on the server only
# --------------------------------------------------------------------------
# Base URL of the API the BFF talks to. Deliberately NOT prefixed with
# NEXT_PUBLIC_: only server-side code reads it, and the browser never needs to
# know where the API lives — it only ever talks to this app's own routes.
BACKEND_API_URL=                 # e.g. http://localhost:8000

# --------------------------------------------------------------------------
# Session (ADR-011)
# --------------------------------------------------------------------------
# Name of the HttpOnly cookie that carries the access token. Configurable so two
# deployments sharing a parent domain do not overwrite each other's session.
SESSION_COOKIE_NAME=             # default cheatsheet_session

# --------------------------------------------------------------------------
# Public URLs
# --------------------------------------------------------------------------
# Where this panel is served from. The Google OAuth callback comes back here, and
# it must match GOOGLE_OAUTH_REDIRECT_URI on the backend.
APP_BASE_URL=                    # default http://localhost:3000

# ==========================================================================
# RULE: never put a secret behind NEXT_PUBLIC_*.
#
# Next.js inlines every NEXT_PUBLIC_* variable into the JavaScript bundle that
# is shipped to the browser. Anything placed here is public, permanently, to
# anyone who opens devtools.
#
# Tokens and integration secrets belong in backend/.env.example and
# are only ever read by the backend. The panel reaches integrations through the
# API, never directly (ADR-011: the BFF is the only thing that talks to the API,
# and the JWT travels in an HttpOnly cookie the browser JavaScript cannot read).
# Exception: Google Picker requires a browser-visible API key restricted in Google
# Cloud to this website's origin plus https://docs.google.com/*, and to the
# Picker and Drive APIs. It is not an OAuth secret.
# The OAuth client ID and Cloud project number are public identifiers too.
NEXT_PUBLIC_GOOGLE_PICKER_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_PROJECT_NUMBER=
#
# The session, backend URL and app URL above remain server-side values.
# ==========================================================================

# ADR-0014: the CUIT companies delegate ARCA's «Facturación Electrónica» web service to,
# shown in the instructions of Integraciones › ARCA. Read by the server only. Optional:
# without it the instructions still render, minus the number.
CUIT_DE_CHEATSHEET=               # e.g. 20-11111111-2
