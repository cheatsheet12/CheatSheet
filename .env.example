# ==========================================================================
# .env.example — environment variable template (section 4.2 of the plan)
#
# Copy to `.env` and fill in the values for the target environment.
# `.env` is excluded from the repository: it is NEVER committed.
# Real credentials are distributed over a private, encrypted channel.
#
# Adding an integration means adding its variables here, EMPTY, in the same PR.
# ==========================================================================

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
ENVIRONMENT=                     # dev | staging | prod
LOG_LEVEL=

# --------------------------------------------------------------------------
# Data stores (ADR-002, ADR-004, ADR-005)
# --------------------------------------------------------------------------
DATABASE_URL=                    # PostgreSQL 16 with pgvector + btree_gist
REDIS_URL=                       # Celery broker + ephemeral conversation state
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Cloudflare R2, reached through the S3-compatible API
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=

# --------------------------------------------------------------------------
# Security (ADR-011)
# --------------------------------------------------------------------------
JWT_SECRET_KEY=                  # signs the short-lived access token
JWT_ACCESS_TOKEN_MINUTES=
REFRESH_TOKEN_DAYS=
# AES-256-GCM key for integration secrets at rest. Held OUTSIDE the database,
# so database access alone never yields decryptable credentials.
SECRETS_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# ARCA / AFIP — electronic invoicing (billing, reference_data)
# --------------------------------------------------------------------------
AFIP_CUIT=
AFIP_CERT_PATH=                  # X.509 certificate, referenced by path — never committed
AFIP_KEY_PATH=
AFIP_WSAA_URL=
AFIP_WSFE_URL=

# --------------------------------------------------------------------------
# MercadoPago — payments
# --------------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=               # HMAC signature validation on inbound webhooks

# --------------------------------------------------------------------------
# WhatsApp Business — conversational
# --------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=             # HMAC signature validation on inbound webhooks

# --------------------------------------------------------------------------
# Spreadsheets — spreadsheet_sync
# --------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=   # needed for protected-range write-back
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_GRAPH_CLIENT_ID=                 # Excel Online, read-only in the MVP
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --------------------------------------------------------------------------
# AI — spreadsheet_sync (semantic mapping) and conversational (intent)
# --------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=                        # pinned by configuration, never hardcoded
AI_TIMEOUT_SECONDS=
AI_MAX_TOKENS=
TRANSCRIPTION_API_KEY=           # voice notes: transcribed, then discarded

# --------------------------------------------------------------------------
# Transactional email — reporting, payments
# --------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# --------------------------------------------------------------------------
# Frontend (dashboard). NEVER put a secret behind NEXT_PUBLIC_*.
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=
