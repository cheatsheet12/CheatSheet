# ==========================================================================
# .env.example — plantilla de variables de entorno (sección 4.2 del plan)
#
# Copiar a `.env` y completar con los valores del entorno correspondiente.
# El archivo `.env` está excluido del repositorio: NUNCA se versiona.
# Las credenciales reales se distribuyen por un canal privado y cifrado.
# ==========================================================================

# Integración AFIP/ARCA
AFIP_CUIT=
AFIP_CERT_PATH=
AFIP_KEY_PATH=
AFIP_WSAA_URL=
AFIP_WSFE_URL=

# Integración MercadoPago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Integración WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Modelos de IA
AI_API_KEY=
AI_MODEL=

# Base de datos
DATABASE_URL=
