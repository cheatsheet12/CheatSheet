# ==========================================================================
# backend/.env.example — environment variable template for the API and workers
# (section 4.2 of docs/configuration-management.md)
#
# Copy to `backend/.env` and fill in the values for the target environment.
# `.env` is excluded from the repository: it is NEVER committed.
# Real credentials are distributed over a private, encrypted channel.
#
# This file covers the backend only. The panel has its own template in
# frontend/.env.example — an env file lives next to the process that reads it.
#
# Adding an integration means adding its variables here, EMPTY, in the same PR.
#
# Two kinds of entry live below, and telling them apart matters:
#   · Variables `platform/settings.py` READS TODAY. Copying this file has to be
#     enough to boot the process, so these must match that module exactly.
#   · Variables FORWARD-DECLARED for an epic that has not arrived (R2_*, AFIP_*,
#     MP_*, WHATSAPP_TOKEN/PHONE_ID/*_SECRET, AFIP_WSFE_URL, MS_GRAPH_*, AI_*).
#     Nothing reads them yet; they are here so the shape of the final
#     configuration is visible from the start.
# ==========================================================================

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
APP_ENV=                         # local | test | staging | production
LOG_LEVEL=                       # default INFO

# --------------------------------------------------------------------------
# Data stores (ADR-002, ADR-004, ADR-005)
# --------------------------------------------------------------------------
DATABASE_URL=                    # PostgreSQL 16 with pgvector + btree_gist
# Migrations connect as the table OWNER; the application never does. That split is
# what makes Row-Level Security real — an application role that owned the tables
# could turn its own policies off (see migrations/versions/0001).
DATABASE_URL_MIGRATIONS=
REDIS_URL=                       # Celery broker + ephemeral conversation state
CELERY_BROKER_URL=               # defaults to REDIS_URL
CELERY_RESULT_BACKEND=           # defaults to REDIS_URL

# Cloudflare R2, reached through the S3-compatible API.
# Forward-declared: first read by the report generator, epic 9.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=

# --------------------------------------------------------------------------
# Sessions and secrets (ADR-011)
# --------------------------------------------------------------------------
JWT_SECRET=                      # required; signs the short-lived access token
JWT_ACCESS_TTL_MINUTOS=          # default 15
REFRESH_TTL_DIAS=                # default 30
TERMINOS_VERSION_VIGENTE=        # default 1.0 — recorded with each acceptance
# AES-256-GCM key for integration credentials at rest (ADR-0003). Held OUTSIDE the
# database, so database access alone never yields decryptable credentials.
# Required: 32 bytes, base64. Generate one with
#   python -c "from cheatsheet.contexts.integrations.infrastructure.cifrado import generar_clave; print(generar_clave())"
SECRETS_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# The panel, and the links the backend builds into it
# --------------------------------------------------------------------------
APP_BASE_URL=                    # default http://localhost:3000

# --------------------------------------------------------------------------
# Google OAuth2 sign-in — identity (HU-E1-01 RN-02)
# --------------------------------------------------------------------------
# PLATFORM credentials, not per company. Empty outside production selects
# `ProveedorOAuthSimulado`, which refuses to be constructed in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --------------------------------------------------------------------------
# Invitations and transactional email — identity (HU-E1-04)
# --------------------------------------------------------------------------
INVITACION_TTL_DIAS=             # default 7
# `consola` writes the invitation link to the log and opens no socket; it is
# REJECTED in production, where this must say `smtp`.
EMAIL_ADAPTADOR=                 # smtp | consola
# SMTP rather than a provider SDK on purpose: which transactional provider to use
# (SendGrid, Postmark, SES) stays a deployment decision, not a code dependency.
SMTP_HOST=
SMTP_PORT=                       # default 587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=                  # default: CheatSheet <no-reply@localhost>
SMTP_TLS=                        # default true
SMTP_TIMEOUT_SEGUNDOS=           # default 10

# --------------------------------------------------------------------------
# External integrations — integrations (HU-E2-05)
# --------------------------------------------------------------------------
# Per-provider ceiling on the live connection check. The four run in parallel, so
# this bounds the whole response, not the sum.
INTEGRACION_TIMEOUT_SEGUNDOS=    # default 5

# --------------------------------------------------------------------------
# WhatsApp Business connection — integrations (HU-E2-03)
#
# NOTE: these are NOT the WHATSAPP_* variables further down. Those are PLATFORM
# credentials for the inbound webhooks of the conversational agent (epic 8). The
# token used to connect a company's number is PER COMPANY and lives encrypted in
# `configuracion_de_integracion` — never in a .env. The two are easy to confuse
# and confusing them would mean every company messaging from the same number.
# --------------------------------------------------------------------------
# `simulado` fabricates Meta's payloads and runs them through the real translation
# layer, so the whole flow works with no Meta app. REJECTED in production.
WHATSAPP_ADAPTADOR=              # meta | simulado
WHATSAPP_GRAPH_URL=              # default https://graph.facebook.com
# Pinned by configuration, never hardcoded: Meta deprecates a Graph version roughly
# every quarter and the fix must not require a release.
WHATSAPP_GRAPH_VERSION=          # default v21.0
WHATSAPP_TIMEOUT_SEGUNDOS=       # default 10
# How often Beat asks Meta whether the number was verified. Meta takes 24-72 h
# (HU-E2-03 RN-02), so 30 minutes bounds the delay to ~1% of the wait.
WHATSAPP_SONDEO_MINUTOS=         # default 30
# When to stop waiting and mark the integration not connected. More than double
# RN-02's ceiling; without it a number Meta never answers about is polled forever.
WHATSAPP_SONDEO_MAXIMO_DIAS=     # default 7

# --------------------------------------------------------------------------
# ARCA — fiscal credentials and access tickets (HU-E2-01, ADR-0004)
#
# The certificate and private key are PER COMPANY and live encrypted in
# `configuracion_de_integracion`. They are NEVER here, and there is deliberately
# no platform-wide certificate: one would let a company issue documents under
# another company's CUIT. (AFIP_CERT_PATH and AFIP_KEY_PATH used to be declared
# here and were removed for exactly that reason.)
# --------------------------------------------------------------------------
# `simulado` reuses the real credential parsing and the real expiry mapping and
# replaces only the network call. REJECTED in production.
ARCA_ADAPTADOR=                  # arca | simulado
# Two separate hosts, unlike Meta. Which one is used comes from APP_ENV, so the
# environment decides whether a document is a rehearsal or irreversible.
ARCA_WSAA_URL_HOMOLOGACION=      # default https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSAA_URL_PRODUCCION=        # default https://wsaa.afip.gov.ar/ws/services/LoginCms
# The taxpayer registry (padron A5) that HU-E1-02 RN-01 validates the CUIT against.
# A different host from WSAA, split by environment the same way and by the same flag.
ARCA_PADRON_URL_HOMOLOGACION=    # default https://awshomo.afip.gov.ar/sr-padron/webservices/personaServiceA5
ARCA_PADRON_URL_PRODUCCION=      # default https://aws.afip.gov.ar/sr-padron/webservices/personaServiceA5
# Longer than Meta's: ARCA is slower, and a login that times out on a busy
# morning looks to the Administrator exactly like a rejected certificate.
ARCA_TIMEOUT_SEGUNDOS=           # default 15
# How long before an access ticket expires we mint a new one instead of reusing it.
ARCA_MARGEN_RENOVACION_MINUTOS=  # default 30
# How far ahead of the certificate's expiry the daily sweep warns. Renewing at ARCA
# takes days, so finding out on the day it expired means not being able to invoice.
ARCA_AVISO_VENCIMIENTO_DIAS=     # default 30

# --------------------------------------------------------------------------
# ARCA — invoicing endpoints. Forward-declared (epic 5, WSFEv1).
# --------------------------------------------------------------------------
AFIP_WSFE_URL=

# --------------------------------------------------------------------------
# MercadoPago — payments. Forward-declared (epic 6).
# --------------------------------------------------------------------------
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=               # HMAC signature validation on inbound webhooks

# --------------------------------------------------------------------------
# WhatsApp Business, PLATFORM side — conversational. Forward-declared (epic 8).
# These are for the inbound webhooks, not for connecting a company's number: see
# the WHATSAPP_ADAPTADOR block above.
# --------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=             # HMAC signature validation on inbound webhooks

# --------------------------------------------------------------------------
# Spreadsheets — spreadsheet_sync. Forward-declared (epic 4).
# --------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=   # needed for protected-range write-back
MS_GRAPH_CLIENT_ID=                 # Excel Online, read-only in the MVP
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --------------------------------------------------------------------------
# AI — spreadsheet_sync (semantic mapping) and conversational (intent).
# Forward-declared (epics 4 and 8).
# --------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=                        # pinned by configuration, never hardcoded
AI_TIMEOUT_SECONDS=
AI_MAX_TOKENS=
TRANSCRIPTION_API_KEY=           # voice notes: transcribed, then discarded
