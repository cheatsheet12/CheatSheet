# ==========================================================================
# backend/.env.example — environment variable template for the API and workers
# (section 4.2 of docs/configuration-management.md)
#
# Copy to `backend/.env` and fill in the values for the target environment.
# `.env` is excluded from the repository: it is NEVER committed.
# Real credentials are distributed over a private, encrypted channel.
#
# This file covers the backend only. The panel has its own template in
# frontend/.env.example — an env file lives next to the process that reads it.
#
# Adding an integration means adding its variables here, EMPTY, in the same PR.
#
# Two kinds of entry live below, and telling them apart matters:
#   · Variables `platform/settings.py` READS TODAY. Copying this file has to be
#     enough to boot the process, so these must match that module exactly.
#   · Variables FORWARD-DECLARED for an epic that has not arrived (R2_*, AFIP_*,
#     MP_*, WHATSAPP_TOKEN/PHONE_ID/*_SECRET, AFIP_WSFE_URL, MS_GRAPH_*, AI_*).
#     Nothing reads them yet; they are here so the shape of the final
#     configuration is visible from the start.
# ==========================================================================

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
APP_ENV=                         # local | test | staging | production
LOG_LEVEL=                       # default INFO

# --------------------------------------------------------------------------
# Data stores (ADR-002, ADR-004, ADR-005)
# --------------------------------------------------------------------------
DATABASE_URL=                    # PostgreSQL 16 with pgvector + btree_gist
# Migrations connect as the table OWNER; the application never does. That split is
# what makes Row-Level Security real — an application role that owned the tables
# could turn its own policies off (see migrations/versions/0001).
DATABASE_URL_MIGRATIONS=
REDIS_URL=                       # Celery broker + ephemeral conversation state
CELERY_BROKER_URL=               # defaults to REDIS_URL
CELERY_RESULT_BACKEND=           # defaults to REDIS_URL

# Cloudflare R2, reached through the S3-compatible API.
# Forward-declared: first read by the report generator, epic 9.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Modelo de lenguaje (ADR-0007) ------------------------------------------
# 'anthropic' o 'simulado'. El simulado mapea los encabezados por parecido de
# texto y no abre ningun socket, asi que la ingesta se recorre entera en una
# laptop sin API key. Rechazado en produccion: un mapeo adivinado por distancia
# de texto produce un catalogo que parece bien y esta mal.
LLM_ADAPTADOR=                   # default simulado (prohibido en production)
ANTHROPIC_API_KEY=
# El modelo que eligio el ADR-0007. Es una variable y no una constante del
# codigo para que probar otro sea un despliegue y no un release.
LLM_MODELO=                      # default claude-opus-5
# Obligatorios los dos (CLAUDE.md seccion 5). El default del SDK son diez
# minutos, y la pantalla de revision de mapeo no puede esperar tanto.
LLM_TIMEOUT_SEGUNDOS=            # default 30
LLM_MAX_TOKENS=                  # default 4096
# Cada cuanto Beat relee las planillas vivas y empuja la escritura de vuelta
# (HU-E3-04). Una hora: una planilla de una PyME cambia varias veces por dia, no
# varias veces por minuto, y cada corrida cuesta una llamada por empresa.
SYNC_PLANILLAS_MINUTOS=          # default 60

# --- Facturacion electronica: WSFEv1 (ADR-0008) -----------------------------
# 'wsfe' o 'simulado'. El simulado devuelve los codigos REALES de ARCA -- 1 es
# Factura A, 5 es la alicuota del 21 % -- porque un simulador con codigos
# inventados dejaria pasar tests que ARCA rechazaria. Rechazado en produccion.
CATALOGOS_FISCALES_ADAPTADOR=    # default simulado (prohibido en production)
# ARCA separa homologacion de produccion a nivel de DNS. Se elige por APP_ENV y
# nunca por defecto: es la diferencia entre practicar y facturar de verdad.
ARCA_WSFE_URL_HOMOLOGACION=      # default https://wswhomo.afip.gov.ar/wsfev1/service.asmx
ARCA_WSFE_URL_PRODUCCION=        # default https://servicios1.afip.gov.ar/wsfev1/service.asmx
# El barrido menos frecuente del sistema: los catalogos de ARCA se mueven una vez
# cada varios meses. Preguntar mas seguido gasta un ticket de 12 h para nada.
PARAMETROS_FISCALES_HORAS=       # default 24
#
# Lo que el modelo ve: SOLO los nombres de las columnas, nunca filas de datos
# (decision D12 del mapa de unidades, CLAUDE.md seccion 3.6). El ejemplo de dato
# que muestra PAN-ING-02 se lee de la planilla y se renderiza sin pasar por aca.
R2_BUCKET=
R2_ENDPOINT_URL=

# --------------------------------------------------------------------------
# Sessions and secrets (ADR-011)
# --------------------------------------------------------------------------
JWT_SECRET=                      # required; signs the short-lived access token
JWT_ACCESS_TTL_MINUTOS=          # default 15
REFRESH_TTL_DIAS=                # default 30
TERMINOS_VERSION_VIGENTE=        # default 1.0 — recorded with each acceptance
# AES-256-GCM key for integration credentials at rest (ADR-0003). Held OUTSIDE the
# database, so database access alone never yields decryptable credentials.
# Required: 32 bytes, base64. Generate one with
#   python -c "from cheatsheet.contexts.integrations.infrastructure.cifrado import generar_clave; print(generar_clave())"
SECRETS_ENCRYPTION_KEY=

# --------------------------------------------------------------------------
# The panel, and the links the backend builds into it
# --------------------------------------------------------------------------
APP_BASE_URL=                    # default http://localhost:3000

# --------------------------------------------------------------------------
# Google OAuth2 sign-in — identity (HU-E1-01 RN-02)
# --------------------------------------------------------------------------
# PLATFORM credentials, not per company. Empty outside production selects
# `ProveedorOAuthSimulado`, which refuses to be constructed in production.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --------------------------------------------------------------------------
# Invitations and transactional email — identity (HU-E1-04)
# --------------------------------------------------------------------------
INVITACION_TTL_DIAS=             # default 7
# `consola` writes the invitation link to the log and opens no socket; it is
# REJECTED in production, where this must say `smtp`.
EMAIL_ADAPTADOR=                 # smtp | consola
# SMTP rather than a provider SDK on purpose: which transactional provider to use
# (SendGrid, Postmark, SES) stays a deployment decision, not a code dependency.
SMTP_HOST=
SMTP_PORT=                       # default 587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=                  # default: CheatSheet <no-reply@localhost>
SMTP_TLS=                        # default true
SMTP_TIMEOUT_SEGUNDOS=           # default 10

# --------------------------------------------------------------------------
# External integrations — integrations (HU-E2-05)
# --------------------------------------------------------------------------
# Per-provider ceiling on the live connection check. The four run in parallel, so
# this bounds the whole response, not the sum.
INTEGRACION_TIMEOUT_SEGUNDOS=    # default 5

# --------------------------------------------------------------------------
# WhatsApp Business connection — integrations (HU-E2-03)
#
# NOTE: these are NOT the WHATSAPP_* variables further down. Those are PLATFORM
# credentials for the inbound webhooks of the conversational agent (epic 8). The
# token used to connect a company's number is PER COMPANY and lives encrypted in
# `configuracion_de_integracion` — never in a .env. The two are easy to confuse
# and confusing them would mean every company messaging from the same number.
# --------------------------------------------------------------------------
# `simulado` fabricates Meta's payloads and runs them through the real translation
# layer, so the whole flow works with no Meta app. REJECTED in production.
WHATSAPP_ADAPTADOR=              # meta | simulado
WHATSAPP_GRAPH_URL=              # default https://graph.facebook.com
# Pinned by configuration, never hardcoded: Meta deprecates a Graph version roughly
# every quarter and the fix must not require a release.
WHATSAPP_GRAPH_VERSION=          # default v21.0
WHATSAPP_TIMEOUT_SEGUNDOS=       # default 10
# How often Beat asks Meta whether the number was verified. Meta takes 24-72 h
# (HU-E2-03 RN-02), so 30 minutes bounds the delay to ~1% of the wait.
WHATSAPP_SONDEO_MINUTOS=         # default 30
# When to stop waiting and mark the integration not connected. More than double
# RN-02's ceiling; without it a number Meta never answers about is polled forever.
WHATSAPP_SONDEO_MAXIMO_DIAS=     # default 7

# --- Cola de fallos (DLQ) — HS-T6 -------------------------------------------
# Cada cuánto Beat retira las tareas que agotaron sus reintentos. Una tarea en
# FALLIDA es invisible para el operador hasta que se la deriva, así que el
# intervalo es corto por visibilidad, no por urgencia del trabajo.
DLQ_BARRIDO_MINUTOS=             # default 15
# El techo de reintentos contra el que juzga el barrido. Tiene que coincidir con
# el de PoliticaDeReintentos (workers/base.py): retirar tareas con un techo
# distinto del que se las reintentó significa retirarlas de más o nunca. Hay un
# test que lo verifica.
DLQ_MAX_INTENTOS=                # default 5

# --- Sincronizacion de planillas (HU-E2-04) ---------------------------------
# 'google' o 'simulado'. El simulado recorre el ida y vuelta OAuth2 contra
# nuestro propio callback y devuelve una planilla fabricada, asi que el flujo se
# completa en una laptop sin cliente de Google. Rechazado en produccion.
PLANILLA_ADAPTADOR=              # default simulado (prohibido en production)
# Donde van los libros subidos: 'r2', 'disco' o 'memoria'.
#
# 'memoria' alcanza para subir una planilla y mapearla, y NO alcanza para
# procesarla: RN-01 hace el procesamiento asincrono, asi que los bytes los lee un
# worker de Celery -- otro proceso, otro dict -- y la carga muere con
# 'planilla_sin_archivo_para_procesar'. Para recorrer la ingesta entera en una
# laptop, 'disco'. Los dos son rechazados en produccion.
ALMACENAMIENTO_ADAPTADOR=        # default memoria (prohibido en production)
# Solo para 'disco'. Vacio usa un directorio bajo el temporal del sistema. Tiene
# que ser el mismo para la API y para los workers, que es el punto.
ALMACENAMIENTO_DIRECTORIO=
# Cloudflare R2. Son credenciales de plataforma, no por empresa: el bucket es
# uno solo y las claves de los objetos llevan el empresa_id adelante.
R2_ENDPOINT=                     # https://<account>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# El cliente OAuth2 de Google se reusa del login del epico 1 (GOOGLE_OAUTH_*),
# pero el consentimiento de la planilla pide un alcance distinto -- drive.file,
# por archivo elegido y no por todo el Drive (HU-E2-04 RN-01) -- y vuelve a su
# propio callback. Hay que habilitar la API de Google Sheets en el mismo
# proyecto de Google Cloud.

# --------------------------------------------------------------------------
# ARCA — fiscal credentials and access tickets (HU-E2-01, ADR-0004)
#
# The certificate and private key are PER COMPANY and live encrypted in
# `configuracion_de_integracion`. They are NEVER here, and there is deliberately
# no platform-wide certificate: one would let a company issue documents under
# another company's CUIT. (AFIP_CERT_PATH and AFIP_KEY_PATH used to be declared
# here and were removed for exactly that reason.)
# --------------------------------------------------------------------------
# `simulado` reuses the real credential parsing and the real expiry mapping and
# replaces only the network call. REJECTED in production.
ARCA_ADAPTADOR=                  # arca | simulado
# ADR-0014: companies delegate «Facturación Electrónica» to CheatSheet's CUIT, and every
# one of them is reached through ONE platform certificate. This is that certificate and
# its private key, PEM, one after the other, base64-encoded onto a single line:
#   { cat cheatsheet.crt; echo; cat cheatsheet.key; } | base64 | tr -d '\n'
# The `echo` matters: the certificate WSASS hands out ends without a newline.
# REQUIRED when ARCA_ADAPTADOR=arca. The most valuable secret of the system: with it,
# anyone can invoice for every customer. Never commit it, never paste it in a chat.
ARCA_CREDENCIAL_PLATAFORMA=
# ARCA's taxpayer registry, switched apart from WSFE. Defaults to ARCA_ADAPTADOR.
# In staging set it to `simulado`: the homologación registry does not know the
# fictitious CUITs of the test companies (checked 2026-10-08), while invoicing still goes
# to ARCA for a real CAE (granted to a fictitious CUIT, checked 2026-10-10). A simulated
# padrón asks WSAA for nothing. REJECTED as `simulado` in production.
ARCA_PADRON_ADAPTADOR=           # arca | simulado
# Two separate hosts, unlike Meta. Which one is used comes from APP_ENV, so the
# environment decides whether a document is a rehearsal or irreversible.
ARCA_WSAA_URL_HOMOLOGACION=      # default https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSAA_URL_PRODUCCION=        # default https://wsaa.afip.gov.ar/ws/services/LoginCms
# The taxpayer registry (padron A5) that HU-E1-02 RN-01 validates the CUIT against.
# A different host from WSAA, split by environment the same way and by the same flag.
ARCA_PADRON_URL_HOMOLOGACION=    # default https://awshomo.afip.gov.ar/sr-padron/webservices/personaServiceA5
ARCA_PADRON_URL_PRODUCCION=      # default https://aws.afip.gov.ar/sr-padron/webservices/personaServiceA5
# Longer than Meta's: ARCA is slower, and a login that times out on a busy
# morning looks to the Administrator exactly like a rejected certificate.
ARCA_TIMEOUT_SEGUNDOS=           # default 15
# How long before an access ticket expires we mint a new one instead of reusing it.
ARCA_MARGEN_RENOVACION_MINUTOS=  # default 30
# How far ahead of the certificate's expiry the daily sweep warns. Renewing at ARCA
# takes days, so finding out on the day it expired means not being able to invoice.
ARCA_AVISO_VENCIMIENTO_DIAS=     # default 30

# --------------------------------------------------------------------------
# ARCA — invoicing endpoints. Forward-declared (epic 5, WSFEv1).
# --------------------------------------------------------------------------
AFIP_WSFE_URL=

# --------------------------------------------------------------------------
# MercadoPago — connecting a company's account (HU-E2-02)
#
# CLIENT_ID and CLIENT_SECRET identify OUR APPLICATION, not a company — the same
# shape as the Google OAuth client above. What is per company are the access and
# refresh tokens the OAuth2 flow returns, and those live encrypted in
# `configuracion_de_integracion`. They are NEVER here.
#
# There is no sandbox host: the same API serves every environment, and what
# separates a test account from a real one is `live_mode`, which the adapter
# cross-checks against APP_ENV. A real account in a non-production deployment is
# refused outright.
# --------------------------------------------------------------------------
# `simulado` walks the whole OAuth2 round trip, redirect included, through the real
# Anti-Corruption Layer. REJECTED in production.
MERCADOPAGO_ADAPTADOR=           # mercadopago | simulado
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Must match, character for character, the URI registered in the MercadoPago
# application. Defaults to APP_BASE_URL + /configuracion/integraciones, so a
# deployment that sets only APP_BASE_URL still agrees with itself.
MERCADOPAGO_REDIRECT_URI=        # default {APP_BASE_URL}/configuracion/integraciones
MERCADOPAGO_AUTH_URL=            # default https://auth.mercadopago.com.ar
MERCADOPAGO_API_URL=             # default https://api.mercadopago.com
MERCADOPAGO_TIMEOUT_SEGUNDOS=    # default 10
# The access token lasts about 180 days; renewing a fortnight early leaves fourteen
# daily attempts before anything breaks.
MERCADOPAGO_MARGEN_RENOVACION_DIAS=   # default 15
# How long an authorization may stay in flight. Longer than anyone takes to press a
# button, shorter than a tab left open over lunch.
MERCADOPAGO_AUTORIZACION_TTL_MINUTOS= # default 10
# The API's public root, NOT the panel's. Every payment link sends MercadoPago
# {API_URL_PUBLICA}/webhooks/mercadopago/{empresa_id} as its notification_url: the
# webhook configured in the MercadoPago application is a single URL and cannot carry
# the company. REQUIRED when MERCADOPAGO_ADAPTADOR=mercadopago; without it a link
# collects the money and never reports it.
API_URL_PUBLICA=                 # e.g. https://cheatsheet-api-xxxx.onrender.com

# --------------------------------------------------------------------------
# MercadoPago, PLATFORM side — payments. Forward-declared (epic 6).
#
# MP_ACCESS_TOKEN used to be declared here and was removed: it described a
# platform-wide seller token that must not exist, the same mistake AFIP_CERT_PATH
# was. The token is per company and arrives through the OAuth2 flow above.
# --------------------------------------------------------------------------
MP_WEBHOOK_SECRET=               # HMAC signature validation on inbound webhooks

# --------------------------------------------------------------------------
# WhatsApp Business, PLATFORM side — conversational. Forward-declared (epic 8).
# These are for the inbound webhooks, not for connecting a company's number: see
# the WHATSAPP_ADAPTADOR block above.
# --------------------------------------------------------------------------

WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_SECRET=             # HMAC signature validation on inbound webhooks

# --------------------------------------------------------------------------
# Spreadsheets — spreadsheet_sync. Forward-declared (epic 4).
# --------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=   # needed for protected-range write-back
MS_GRAPH_CLIENT_ID=                 # Excel Online, read-only in the MVP
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# --------------------------------------------------------------------------
# AI — spreadsheet_sync (semantic mapping) and conversational (intent).
# Forward-declared (epics 4 and 8).
# --------------------------------------------------------------------------
AI_API_KEY=
AI_MODEL=                        # pinned by configuration, never hardcoded
AI_TIMEOUT_SECONDS=
AI_MAX_TOKENS=
TRANSCRIPTION_API_KEY=           # voice notes: transcribed, then discarded
