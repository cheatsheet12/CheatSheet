# ==========================================================================
# Credentials and environment variables — NEVER commit (section 4.1 of the plan)
# ==========================================================================
.env
*.env
.env.*
!.env.example

# Certificates and keys (AFIP/ARCA and others)
*.pem
*.key
*.crt
*.p12
*.pfx

# ==========================================================================
# Python
# ==========================================================================
# The directory patterns below are ANCHORED on purpose.
#
# They are ordinary English words — lib, build, dist, var, parts — and a gitignore
# pattern without a slash matches at EVERY depth, in every language. That is not a
# hypothetical: an unanchored `lib/` silently swallowed `frontend/src/lib/`, the BFF
# layer of ADR-0002. The code type-checked on a laptop, where the files exist, and
# did not exist at all in CI, where only what git tracks is checked out.
#
# A Python distribution is only ever built where a pyproject.toml lives, so these are
# matched there and nowhere else.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
.installed.cfg
*.egg

/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/

backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# ==========================================================================
# Node.js / Next.js (frontend)
# ==========================================================================
node_modules/
.npm/
.pnp.*
.yarn/

# Next.js
.next/
out/
next-env.d.ts

# Frontend build
frontend/build/
frontend/dist/

# Frontend test coverage
coverage/
*.lcov

# TypeScript incremental build cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ==========================================================================
# Claude Code
# The shared team configuration (.claude/settings.json and the hooks) IS
# committed: it holds the repository rules. Only each member's personal
# overrides are excluded.
# ==========================================================================
.claude/settings.local.json

# ==========================================================================
