# ==========================================================================
# dashboard/.env.example — environment variable template for the Next.js panel
#
# Copy to `dashboard/.env.local` and fill it in. `.env*` files are excluded
# from the repository: they are NEVER committed.
#
# The backend has its own template in backend/.env.example — an env file lives
# next to the process that reads it, and these are two separately deployed
# processes (Vercel for the panel, a container service for the API).
# ==========================================================================

# --------------------------------------------------------------------------
# Backend API
# --------------------------------------------------------------------------
# Base URL of the API the BFF talks to.
NEXT_PUBLIC_API_BASE_URL=

# ==========================================================================
# RULE: never put a secret behind NEXT_PUBLIC_*.
#
# Next.js inlines every NEXT_PUBLIC_* variable into the JavaScript bundle that
# is shipped to the browser. Anything placed here is public, permanently, to
# anyone who opens devtools.
#
# Tokens, API keys and integration secrets belong in backend/.env.example and
# are only ever read by the backend. The panel reaches integrations through the
# API, never directly (ADR-011: the BFF is the only thing that talks to the API,
# and the JWT travels in an HttpOnly cookie the browser JavaScript cannot read).
# ==========================================================================
