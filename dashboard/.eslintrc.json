{
  "root": true,
  "extends": ["next/core-web-vitals", "prettier"],
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "always"],
    "no-restricted-syntax": [
      "error",
      {
        "selector": "TSAnyKeyword",
        "message": "`any` is forbidden (code-standards §3). Use `unknown` and validate it against a schema."
      },
      {
        "selector": "TSTypeAssertion, TSAsExpression[typeAnnotation.type='TSAnyKeyword']",
        "message": "Casting to `any` defeats the type checker. Narrow the type instead."
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../../features/*", "../../../features/*", "@/features/*/!(index)*"],
            "message": "Cross-feature imports must go through the feature's public entry point (see R5 in docs/architecture.md). Shared code belongs in @/shared."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-restricted-syntax": "off" }
    }
  ],
  "ignorePatterns": ["node_modules/", ".next/", "coverage/", "next-env.d.ts"]
}
